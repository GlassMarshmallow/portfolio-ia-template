# Copia este archivo como .env en el servidor y rellénalo. NUNCA subas el .env a git.

# ─── IA (elige una; ver README → Conectar la IA) ───────────────────────────────────────────────
# Vacío: sin IA (el chat avisa de que no está conectada). "ollama" o "openai".
IA_PROVEEDOR=

# Si IA_PROVEEDOR=ollama (arranca con: docker compose --profile ollama up -d --build)
# OLLAMA_URL=http://ollama:11434/
# OLLAMA_MODEL=qwen3:8b

# Si IA_PROVEEDOR=openai (OpenAI u otro servicio compatible: OpenRouter, Groq, Mistral…)
# OPENAI_URL=https://api.openai.com/v1/
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ─── Bot de Telegram que te envía las solicitudes de "Quiero un proyecto" (paso a paso en el README) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Túnel de Cloudflare con dominio propio (opcional; ver README → Publicar en internet) ───
CLOUDFLARE_TUNNEL_TOKEN=
